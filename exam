void merge_sort(T* arr, size_t size, bool (*compare)(T, T)) {
  size_t left_arr_size{ (size + 1) / 2 }, right_arr_size{ size / 2 };
  int* left_arr = new int[left_arr_size], * right_arr = new int[right_arr_size];
  for (size_t i{ 0 };i < left_arr_size;++i) left_arr[i] = arr[i];
  for (size_t i{ 0 };i < right_arr_size;++i)  right_arr[i] = arr[left_arr_size + i];
  if (left_arr_size != 1) merge_sort(left_arr, left_arr_size, compare);
  if (right_arr_size != 1) merge_sort(right_arr, right_arr_size, compare);
  size_t left_arr_ind{ 0 }, right_arr_ind{ 0 }, arr_ind{ 0 };
  while (left_arr_ind < left_arr_size || right_arr_ind < right_arr_size) {
    if (left_arr_ind >= left_arr_size) arr[arr_ind++] = right_arr[right_arr_ind++];
    else if (right_arr_ind >= right_arr_size) arr[arr_ind++] = left_arr[left_arr_ind++];
    else arr[arr_ind++] = compare(left_arr[left_arr_ind], right_arr[right_arr_ind]) ? left_arr[left_arr_ind++] : right_arr[right_arr_ind++];
  }
  delete[] left_arr, right_arr;
