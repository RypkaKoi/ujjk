#include <iostream>
using namespace std;

// Функция слияния двух отсортированных массивов
int* merge(int* left, int leftSize, int* right, int rightSize) {
    int* result = new int[leftSize + rightSize];
    int i = 0, j = 0, k = 0;
    
    // Сравниваем элементы из левого и правого массивов
    while (i < leftSize && j < rightSize) {
        if (left[i] <= right[j]) {
            result[k++] = left[i++];
        } else {
            result[k++] = right[j++];
        }
    }
    
    // Добавляем оставшиеся элементы из левого массива
    while (i < leftSize) {
        result[k++] = left[i++];
    }
    
    // Добавляем оставшиеся элементы из правого массива
    while (j < rightSize) {
        result[k++] = right[j++];
    }
    
    return result;
}

// Рекурсивная сортировка слиянием
int* mergeSort(int* arr, int size) {
    // Базовый случай: массив из 1 элемента
    if (size <= 1) {
        int* result = new int[size];
        for (int i = 0; i < size; i++) {
            result[i] = arr[i];
        }
        return result;
    }
    
    // Находим середину
    int mid = size / 2;
    
    // Создаем левую и правую половины
    int* left = new int[mid];
    int* right = new int[size - mid];
    
    for (int i = 0; i < mid; i++) {
        left[i] = arr[i];
    }
    for (int i = mid; i < size; i++) {
        right[i - mid] = arr[i];
    }
    
    // Рекурсивно сортируем половины
    int* sortedLeft = mergeSort(left, mid);
    int* sortedRight = mergeSort(right, size - mid);
    
    // Сливаем отсортированные половины
    int* result = merge(sortedLeft, mid, sortedRight, size - mid);
    
    // Освобождаем память
    delete[] left;
    delete[] right;
    delete[] sortedLeft;
    delete[] sortedRight;
    
    return result;
}

